node_modules/
.DS_Store

# ui.built.js is deliberately NOT ignored — GitHub Pages serves this repo
# directly with no CI step, so the bundle has to be committed.

# Design-system sync. ds-dist/ is a build artifact (npm run build:ds) that
# nothing serves, unlike ui.built.js. .ds-sync/ holds the staged converter and
# ds-bundle/ its regenerated output; both are recreated on every sync. Inside
# .design-sync/ only machine state is ignored — config.json, NOTES.md,
# conventions.md, and previews/ are committed, since re-syncs read them.
ds-dist/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
