{
  "name": "907hustle-game",
  "version": "1.19.0",
  "description": "907Hustle is a mobile-first, single-player crime, trading, relationship, and light-RPG web game set in an Anchorage-inspired Spenard. A run follows a newcomer balancing clean work, street income, debt, family housing, friendships, rivals, crew, and territory across a dynamic Week Zero.",
  "main": "game-core.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "esbuild src/index.jsx --bundle --format=iife --outfile=ui.built.js --loader:.jsx=jsx --target=es2019",
    "build:watch": "npm run build -- --watch",
    "build:ds": "esbuild src/ds/index.jsx --bundle --format=esm --outfile=ds-dist/index.js --loader:.jsx=jsx --target=es2019 && cp src/ds/index.d.ts ds-dist/index.d.ts",
    "test": "node --test tests/*.test.js",
    "sim": "node tests/simulate-runs.js --total 200",
    "check-docs": "node scripts/check-docs-version.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davonlemar30/907Hustle-game.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/davonlemar30/907Hustle-game/issues"
  },
  "homepage": "https://github.com/davonlemar30/907Hustle-game#readme",
  "devDependencies": {
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2"
  }
}
